generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ------------------------------- Student Schema -------------------------
model Student {
  id                   Int                    @id @default(autoincrement())
  first_name           String?
  last_name            String?
  mid_name             String?
  school_email         String?
  personal_email       String
  department           String?
  course               String?
  major                String?
  nickname             String?
  suffix               String?
  thesis_title         String?
  updated_at           DateTime               @updatedAt
  created_at           DateTime               @default(now())
  student_number       Int                    @unique
  grad_year            Int                    @default(2026)
  grad_term            GraduationTerm         @default(MID_YEAR)

  studentAuth          StudentAuth?
  studentDetail        StudentDetail?
  studentSolicitations StudentSolicitations[]
  booking              Booking[]
  attendanceQueue      AttendanceQueue?
  logs                 Logs[]
  images               StudentImage[]
  reviewCases          ReviewCase[]
}

enum GraduationTerm {
  MID_YEAR
  END_YEAR
}

model StudentDetail {
  id              Int      @id
  birth_date      DateTime
  province        String?
  city            String?
  barangay        String?
  mothers_name    String?
  mothers_title   String?
  fathers_name    String?
  fathers_title   String?
  guardians_name  String?
  guardians_title String?
  contact_num     String?
  photo_url       String?
  student         Student  @relation(fields: [id], references: [id], onDelete: Cascade)
}

model StudentSolicitations {
  id             Int              @id @default(autoincrement())
  student_number Int
  type           SolicitationType
  slot           Int
  title          String?
  name           String?
  student        Student          @relation(fields: [student_number], references: [student_number], onDelete: Cascade)

  @@unique([student_number, slot])
  @@index([student_number, slot])
}

enum SolicitationType {
  PERSON
  COMPANY
}

model StudentAuth {
  is_verified     Boolean       @default(false)
  is_new          Boolean       @default(true)
  hashed_password String?
  last_login      DateTime?
  student_number  Int           @id
  status          StudentStatus @default(REGISTERED)
  student         Student       @relation(fields: [student_number], references: [student_number], onDelete: Cascade)
}

enum StudentStatus {
  REGISTERED
  APPROVED
  BOOKED
  ATTENDED
  FULLY_VERIFIED
}

// ---------------------------------------------------------------------

// ------------------------------- Admin Schema -------------------------
model Admin {
  id                 Int            @id @default(autoincrement())
  email              String?        @unique
  first_name         String?
  last_name          String?
  hashed_password    String
  last_login         DateTime?
  role               AdminRoles     @default(MEMBER)
  can_approve_images Boolean        @default(false)
  logs               Logs[]
  uploadedImages     StudentImage[]
  imageComments      ImageComment[]
  notifications      Notification[] @relation("AdminNotifications")
  reviewAssignments  ReviewAssignment[] @relation("ReviewAssignee")
  reviewGrants       ReviewAssignment[] @relation("ReviewGrantor")
  reviewRevocations  ReviewAssignment[] @relation("ReviewRevoker")
  checkedReviewCases ReviewCase[] @relation("RacChecker")
  reviewOperations   ReviewOperation[] @relation("ReviewOperationActor")
  reviewEvents       ReviewEvent[] @relation("ReviewEventActor")
  reviewRevisions    ReviewRevision[] @relation("ReviewRevisionAuthor")
  informationEvents InformationReviewEvent[] @relation("InformationEventActor")
}

enum ReviewCapability {
  RAC_CHECK
  INFORMATION_PROOFREADER
  INFORMATION_QC
  PHOTO_UPLOADER
  PHOTO_QC
  FINAL_MODERATOR
  IT_CORRECTION
}

// Review capabilities are separate from the existing broad AdminRoles.
// Revocation keeps the original assignment and its attribution.
model ReviewAssignment {
  id          Int              @id @default(autoincrement())
  admin_id    Int
  capability  ReviewCapability
  department  String?
  course      String?
  major       String?
  granted_by  Int
  granted_at  DateTime         @default(now())
  revoked_by  Int?
  revoked_at  DateTime?

  assignee Admin  @relation("ReviewAssignee", fields: [admin_id], references: [id], onDelete: Restrict)
  grantor  Admin  @relation("ReviewGrantor", fields: [granted_by], references: [id], onDelete: Restrict)
  revoker  Admin? @relation("ReviewRevoker", fields: [revoked_by], references: [id], onDelete: Restrict)

  @@index([admin_id, revoked_at])
  @@index([capability, revoked_at])
}

enum RacOutcome {
  VERIFIED
  NOT_LISTED
}

enum ReviewTrackType {
  INFORMATION
  PHOTOS
}

enum ReviewStage {
  DRAFT
  SUBMITTED_QC
  REJECTED_QC
  APPROVED_QC
  SUBMITTED_MODERATOR
  REJECTED_MODERATOR
  LOCKED
}

enum ReviewEventAction {
  RAC_VERIFIED
  RAC_NOT_LISTED
}

enum InformationEventAction {
  COMMENTED
  SUBMITTED_QC
  REJECTED_QC
  APPROVED_QC
  SUBMITTED_MODERATOR
  REJECTED_MODERATOR
  LOCKED
}

// One RAC/SAO result per graduate and graduation cycle. No case means unchecked.
model ReviewCase {
  id          Int            @id @default(autoincrement())
  student_id  Int
  grad_year   Int
  grad_term   GraduationTerm
  outcome     RacOutcome
  checked_by  Int
  checked_at  DateTime       @default(now())
  source_version String       @db.VarChar(100)
  version     Int            @default(1)

  student Student @relation(fields: [student_id], references: [id], onDelete: Restrict)
  checker Admin   @relation("RacChecker", fields: [checked_by], references: [id], onDelete: Restrict)
  tracks  ReviewTrack[]
  events  ReviewEvent[]

  @@unique([student_id, grad_year, grad_term])
  @@index([outcome, grad_year, grad_term])
  @@index([checked_by])
}

model ReviewTrack {
  id       Int             @id @default(autoincrement())
  case_id  Int
  type     ReviewTrackType
  stage    ReviewStage     @default(DRAFT)
  version  Int             @default(1)

  reviewCase ReviewCase @relation(fields: [case_id], references: [id], onDelete: Restrict)
  revisions  ReviewRevision[]
  informationEvents InformationReviewEvent[]

  @@unique([case_id, type])
}

// One operation row makes retry keys unique even when two batches have no
// graduate in common. The response is stored only after the whole batch passes.
model ReviewOperation {
  id           Int      @id @default(autoincrement())
  actor_id     Int
  client_key   String   @db.Uuid
  request_hash String
  response     Json?
  created_at   DateTime @default(now())

  actor    Admin           @relation("ReviewOperationActor", fields: [actor_id], references: [id], onDelete: Restrict)
  events   ReviewEvent[]
  revision ReviewRevision?
  informationEvent InformationReviewEvent?

  @@unique([actor_id, client_key])
}

// Immutable information drafts. Both snapshots contain only the fields that
// a proofreader may edit; the live graduate record changes only at final approval.
model ReviewRevision {
  id              Int      @id @default(autoincrement())
  track_id        Int
  track_version   Int
  before_snapshot Json
  after_snapshot  Json
  canonical_hash  String   @db.VarChar(64)
  created_by      Int
  operation_id    Int      @unique
  created_at      DateTime @default(now())

  track     ReviewTrack     @relation(fields: [track_id], references: [id], onDelete: Restrict)
  author    Admin           @relation("ReviewRevisionAuthor", fields: [created_by], references: [id], onDelete: Restrict)
  operation ReviewOperation @relation(fields: [operation_id], references: [id], onDelete: Restrict)
  informationEvents InformationReviewEvent[]

  @@unique([track_id, track_version])
  @@unique([id, track_id])
  @@index([created_by])
}

// Each decision or comment belongs to the exact saved information revision.
model InformationReviewEvent {
  id            Int                    @id @default(autoincrement())
  track_id      Int
  track_version Int
  revision_id   Int
  actor_id      Int
  operation_id  Int                    @unique
  action        InformationEventAction
  from_stage    ReviewStage
  to_stage      ReviewStage
  note          String?
  created_at    DateTime               @default(now())

  track     ReviewTrack     @relation(fields: [track_id], references: [id], onDelete: Restrict)
  revision  ReviewRevision  @relation(fields: [revision_id, track_id], references: [id, track_id], onDelete: Restrict)
  actor     Admin           @relation("InformationEventActor", fields: [actor_id], references: [id], onDelete: Restrict)
  operation ReviewOperation @relation(fields: [operation_id], references: [id], onDelete: Restrict)

  @@unique([track_id, track_version])
  @@index([actor_id])
}

model ReviewEvent {
  id               Int               @id @default(autoincrement())
  case_id          Int
  actor_id         Int
  operation_id     Int
  action           ReviewEventAction
  previous_outcome RacOutcome?
  new_outcome      RacOutcome
  source_version   String            @db.VarChar(100)
  created_at       DateTime          @default(now())

  reviewCase ReviewCase      @relation(fields: [case_id], references: [id], onDelete: Restrict)
  actor      Admin           @relation("ReviewEventActor", fields: [actor_id], references: [id], onDelete: Restrict)
  operation  ReviewOperation @relation(fields: [operation_id], references: [id], onDelete: Restrict)

  @@unique([operation_id, case_id])
  @@index([case_id, created_at])
  @@index([actor_id])
}

enum AdminRoles {
  ADMINISTRATOR
  MODERATOR
  MEMBER
}

model Logs {
  id         Int          @id @default(autoincrement())
  admin_id   Int
  action     AdminActions
  target_id  Int?
  created_at DateTime     @default(now())

  admin   Admin    @relation(fields: [admin_id], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [target_id], references: [student_number], onDelete: SetNull, onUpdate: Cascade)
}

enum AdminActions {
  APPROVED
  VERIFIED
  UPLOADED
}

model StudentImage {
  id             Int         @id @default(autoincrement())
  student_number Int
  type           ImageType
  year           Int
  photo_url      String
  status         ImageStatus @default(PENDING)
  uploaded_by    Int
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt

  student       Student        @relation(fields: [student_number], references: [student_number], onDelete: Cascade, onUpdate: Cascade)
  admin         Admin          @relation(fields: [uploaded_by], references: [id], onDelete: Restrict)
  comments      ImageComment[]
  notifications Notification[]

  @@unique([student_number, type, year])
  @@index([student_number])
  @@index([type, year])
}

enum ImageType {
  GRADUATION
  THEME
}

enum ImageStatus {
  PENDING
  APPROVED
  REJECTED
}

model ImageComment {
  id         Int      @id @default(autoincrement())
  image_id   Int
  admin_id   Int
  body       String
  is_system  Boolean  @default(false)
  created_at DateTime @default(now())

  image StudentImage @relation(fields: [image_id], references: [id], onDelete: Cascade)
  admin Admin        @relation(fields: [admin_id], references: [id], onDelete: Cascade)

  @@index([image_id])
}

model Notification {
  id           Int              @id @default(autoincrement())
  recipient_id Int
  type         NotificationType
  message      String
  image_id     Int?
  is_read      Boolean          @default(false)
  created_at   DateTime         @default(now())

  recipient Admin         @relation("AdminNotifications", fields: [recipient_id], references: [id], onDelete: Cascade)
  image     StudentImage? @relation(fields: [image_id], references: [id], onDelete: Cascade)

  @@index([recipient_id, is_read])
}

enum NotificationType {
  IMAGE_UPLOADED
  IMAGE_APPROVED
  IMAGE_REJECTED
  IMAGE_COMMENT
}

// ---------------------------------------------------------------------

// ------------------------------- Booking Schema -------------------------
model BookingDay {
  id                Int               @id @default(autoincrement())
  date              DateTime          @unique
  is_open           Boolean           @default(true)
  max_morning_cap   Int
  max_afternoon_cap Int
  slots             BookingSlot[]
  bookings          Booking[]
  attendanceQueue   AttendanceQueue[]
}

model BookingSlot {
  id             Int        @id @default(autoincrement())
  booking_day_id Int
  period         String
  start_time     String
  end_time       String
  capacity       Int
  is_open        Boolean    @default(true)
  booking_day    BookingDay @relation(fields: [booking_day_id], references: [id], onDelete: Cascade)
  bookings       Booking[]

  @@unique([booking_day_id, start_time, end_time])
  @@index([booking_day_id, period])
}

model Booking {
  id              Int          @id @default(autoincrement())
  student_number  Int
  booking_day_id  Int
  booking_slot_id Int?
  period          String
  created_at      DateTime     @default(now())
  booking_day     BookingDay   @relation(fields: [booking_day_id], references: [id], onDelete: Cascade)
  booking_slot    BookingSlot? @relation(fields: [booking_slot_id], references: [id], onDelete: SetNull)
  student         Student      @relation(fields: [student_number], references: [student_number], onDelete: Cascade)

  @@index([booking_slot_id])
}

model AttendanceQueue {
  id             Int      @id @default(autoincrement())
  student_number Int      @unique
  booking_day_id Int
  period         String
  photo_url      String?
  created_at     DateTime @default(now())

  student     Student    @relation(fields: [student_number], references: [student_number], onDelete: Cascade)
  booking_day BookingDay @relation(fields: [booking_day_id], references: [id], onDelete: Cascade)

  @@index([created_at])
  @@index([student_number])
}

